# /etc/nginx/nginx.conf
# Managed by the Juju skyline charm — do not edit by hand.
#
# FALLBACK TEMPLATE: this file is only rendered when the primary config
# generation (skyline-nginx-generator, which emits one proxy location per
# OpenStack service from the keystone catalog) fails — e.g. keystone was
# unreachable at config time. With this fallback the Skyline API works but
# OpenStack service endpoints (/api/openstack/<region>/<service>/...) 404.
# Fix by running the regenerate-nginx action (or a juju config change) once
# keystone is reachable.
#
# Design notes:
#   - gunicorn binds to 127.0.0.1:28000 (loopback only)
#   - nginx is the sole public listener on port {{ listen_port }}
#   - Static React assets are served directly from the skyline_console package
#   - /api/openstack/skyline/ is stripped and proxied to gunicorn, so the
#     browser's /api/openstack/skyline/api/v1/* calls reach the backend's
#     /api/v1/* routes (API_PREFIX in skyline_apiserver/types/constants.py).
#   - The proxy directives below mirror what skyline-nginx-generator emits
#     (guide 7.9). In particular, no Upgrade/Connection headers are forwarded:
#     skyline-apiserver has no WebSocket routes, and uvicorn's httptools
#     parser would treat a Connection: upgrade request as a WebSocket upgrade
#     and reject it with HTTP 400 when uvicorn is not installed with
#     [standard] extras.

user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 1024;
    multi_accept on;
}

http {
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    types_hash_max_size 2048;

    # No body size limit — large uploads (e.g. Glance images) are streamed to
    # the backend, matching the config produced by skyline-nginx-generator.
    client_max_body_size 0;
    proxy_request_buffering off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/json application/javascript application/xml+rss
        application/atom+xml image/svg+xml;

    # ── Upstream — skyline-apiserver via gunicorn ───────────────────────
    upstream skyline_apiserver {
        server 127.0.0.1:28000 fail_timeout=0;
    }

    # ── Virtual server ──────────────────────────────────────────────────
    server {
        listen {{ listen_port }} default_server;
        listen [::]:{{ listen_port }} default_server;

        server_name _;

        access_log /var/log/nginx/skyline_access.log;
        error_log  /var/log/nginx/skyline_error.log;

        # Static assets from the installed skyline_console Python package
        root {{ static_path }};
        index index.html;

        # ── Skyline API ─────────────────────────────────────────────────
        # Trailing slash on proxy_pass replaces the matched /api/openstack/skyline/
        # prefix, so /api/openstack/skyline/api/v1/* -> /api/v1/* on the backend.
        location /api/openstack/skyline/ {
            proxy_pass         http://skyline_apiserver/;
            proxy_redirect     off;
            proxy_buffering    off;

            proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto  $scheme;
            proxy_set_header   X-Forwarded-Host   $host;
            proxy_set_header   Host               $http_host;
        }

        # ── Other OpenStack API paths (fallback passthrough) ────────────
        # FALLBACK ONLY: the primary config (skyline-nginx-generator) proxies
        # each /api/openstack/<region>/<service>/ to the real OpenStack
        # endpoint. Here they are sent to gunicorn, which has no such routes,
        # so service calls return 404 until the config is regenerated.
        location /api/openstack/ {
            proxy_pass         http://skyline_apiserver;
            proxy_redirect     off;
            proxy_buffering    off;

            proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto  $scheme;
            proxy_set_header   X-Forwarded-Host   $host;
            proxy_set_header   Host               $http_host;
        }

        # ── Direct /api/v1 access ───────────────────────────────────────
        location /api/v1/ {
            proxy_pass         http://skyline_apiserver/api/v1/;
            proxy_redirect     off;
            proxy_buffering    off;

            proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto  $scheme;
            proxy_set_header   X-Forwarded-Host   $host;
            proxy_set_header   Host               $http_host;
        }

        # ── React SPA — catch-all ───────────────────────────────────────
        # All non-API requests serve the React app entry point.
        # The React router handles client-side navigation.
        location / {
            try_files $uri $uri/ /index.html;
        }

        # ── Static asset caching ────────────────────────────────────────
        # Webpack output files include a content hash, so they are
        # safe to cache for a long time.
        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }
    }
}
